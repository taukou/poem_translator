# Flask環境
FLASK_ENV=development
FLASK_DEBUG=True

# 服務器配置
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# API密鑰
API_KEY=your_api_key_here

# Azure配置
AZURE_KEY=your_azure_key_here
AZURE_ENDPOINT=https://your-region.api.cognitive.microsoft.com/

# 數據庫配置（可選）
DATABASE_URL=postgresql://user:password@localhost:5432/poem_translator
